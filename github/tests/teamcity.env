# TeamCity supplies GITHUB_ACCESS_TOKEN through the platform OAuth connection.
# Connect autohive-integrations-ci and grant access to both private fixture repos.
GITHUB_TEST_ACTIVITY_USERNAME=autohive-integrations-ci

# Known default-branch commits authored by the dedicated CI account.
# Both commits must be indexed by GitHub search before running the live tests.
GITHUB_TEST_SEARCH_REPO_A=autohive-integrations-ci/github-integration-fixture-a
GITHUB_TEST_SEARCH_SHA_A=7399aa37553c248cdf5586368678351263d22129
GITHUB_TEST_SEARCH_REPO_B=autohive-integrations-ci/github-integration-fixture-b
GITHUB_TEST_SEARCH_SHA_B=37a0122d21eaa28986ee09e41d7516a3f3f1393b

# Verified native Git push of one commit on an existing branch in repository A.
# Pending: uncomment and populate the ID after GitHub publishes the PushEvent.
# GITHUB_TEST_PUSH_EVENT_ID=
GITHUB_TEST_PUSH_REPOSITORY=autohive-integrations-ci/github-integration-fixture-a
GITHUB_TEST_PUSH_REF=refs/heads/main
GITHUB_TEST_PUSH_BEFORE=7399aa37553c248cdf5586368678351263d22129
GITHUB_TEST_PUSH_HEAD=c8a7784a55e81cfb64f16b1ef58eb0a3536c1325

# Refresh the event metadata after a newer push by this account in repository A,
# or before the event leaves GitHub's 30-day / 300-event history.
