                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9_-]+$"
                    }
                },
                "required": [
                    "file_key"
                ],
                "additionalProperties": false
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "meta": {
                        "type": "object",
                        "description": "Figma response object; nested fields are preserved.",
                        "properties": {
                            "components": {
                                "type": "array",
                                "items": {
                                    "type": "object"
                                }
                            },
                            "cursor": {
                                "type": "object",
                                "properties": {
                                    "before": {
                                        "type": "integer"
                                    },
                                    "after": {
                                        "type": "integer"
                                    }
                                }
                            }
                        },
                        "required": [
