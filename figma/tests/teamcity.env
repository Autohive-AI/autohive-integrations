# FIGMA_ACCESS_TOKEN is supplied by the platform OAuth Figma test connection.
# Do not put access tokens in this public file.
# Provision these dedicated-test fixture references in the TeamCity secret store.
FIGMA_TEST_FILE_KEY=ah:secret
FIGMA_TEST_NODE_ID=ah:secret
FIGMA_TEST_TEAM_ID=ah:secret
# TeamCity runs read-only tests; keep write permission explicitly disabled.
FIGMA_RUN_DESTRUCTIVE_TESTS=0
# Optional local destructive fixture; enable only after creating a disposable file.
# FIGMA_TEST_COMMENT_FILE_KEY=ah:secret

# Local PAT fallback is not an OAuth/TeamCity bypass. Do not put a token here.
# FIGMA_PERSONAL_ACCESS_TOKEN=ah:secret
