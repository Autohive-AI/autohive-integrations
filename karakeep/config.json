{
    "name": "Karakeep",
    "display_name": "Karakeep",
    "version": "1.0.0",
    "description": "Save bookmarks and manage tags in Karakeep (Cloud or self-hosted).",
    "entry_point": "karakeep.py",
    "auth": {
        "type": "custom",
        "title": "Karakeep Credentials",
        "fields": {
            "type": "object",
            "properties": {
                "base_url": {
                    "type": "string",
                    "format": "text",
                    "label": "Karakeep URL",
                    "help_text": "Karakeep instance URL (https:// required). For Karakeep Cloud, use https://cloud.karakeep.app. For self-hosted, use your HTTPS URL such as https://karakeep.example.com. Karakeep does not terminate TLS itself — front your self-hosted instance with a reverse proxy or tunnel (Cloudflare Tunnel, Tailscale Funnel, Caddy, nginx, etc.). http:// is not accepted. Do not add a trailing slash or /api/v1."
                },
                "api_key": {
                    "type": "string",
                    "format": "password",
                    "label": "API Key",
                    "help_text": "API key from your Karakeep instance (Settings \u2192 API Keys). When creating the key, grant scopes for bookmarks and tags (read + write). Do not grant admin scopes unless needed."
                }
            }
        }
    },
    "actions": {
        "create_bookmark": {
            "display_name": "Create Bookmark",
            "description": "Create a bookmark of type link (URL), text (note), or asset (image/pdf). For link bookmarks, returns the existing one if the URL is already saved.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": ["link", "text", "asset"],
                        "description": "Bookmark type. 'link' requires url; 'text' requires text; 'asset' requires asset_type and asset_id. Defaults to 'link'."
                    },
                    "url": {
                        "type": "string",
                        "description": "URL to bookmark. Required when type is 'link'."
                    },
                    "text": {
                        "type": "string",
                        "description": "Text content. Required when type is 'text'."
                    },
                    "source_url": {
                        "type": "string",
                        "description": "Optional source URL (for type 'text' or 'asset')."
                    },
                    "asset_type": {
                        "type": "string",
                        "enum": ["image", "pdf"],
                        "description": "Asset media type. Required when type is 'asset'."
                    },
                    "asset_id": {
                        "type": "string",
                        "description": "ID of a previously uploaded asset (via POST /assets). Required when type is 'asset'."
                    },
                    "file_name": {
                        "type": "string",
                        "description": "Optional file name for asset bookmarks."
                    },
                    "title": {
                        "type": "string",
                        "description": "Optional title (max 1000 chars)."
                    },
                    "note": {
                        "type": "string",
                        "description": "Optional note attached to the bookmark."
                    },
                    "summary": {
                        "type": "string",
                        "description": "Optional summary."
                    },
                    "archived": {
                        "type": "boolean",
                        "description": "Whether to archive on creation (default: false)."
                    },
                    "favourited": {
                        "type": "boolean",
                        "description": "Whether to favourite on creation (default: false)."
                    }
                }
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "bookmark_id": {
                        "type": "string",
                        "description": "The id of the created or existing bookmark."
                    },
                    "bookmark": {
                        "type": "object",
                        "description": "The full bookmark object returned by Karakeep."
                    },
                    "already_existed": {
                        "type": "boolean",
                        "description": "True when this URL was already saved (only meaningful for type 'link')."
                    }
                },
                "required": ["bookmark_id", "already_existed"]
            }
        },
        "attach_tags": {
            "display_name": "Attach Tags to Bookmark",
            "description": "Attach one or more tags to a bookmark. Tags can be provided by name (missing names are created automatically) or by existing tag id.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "bookmark_id": {
                        "type": "string",
                        "description": "ID of the bookmark returned by create_bookmark"
                    },
                    "tags": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Tag names to attach. Missing names are created automatically."
                    },
                    "tag_ids": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Existing tag IDs to attach (skips name lookup)."
                    },
                    "attached_by": {
                        "type": "string",
                        "enum": ["ai", "human"],
                        "description": "Who is attaching these tags. Omitted unless set; Karakeep defaults to 'human'."
                    }
                },
                "required": ["bookmark_id"]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "attached": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "IDs of the tags that were attached"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Number of tag items sent for attachment"
                    }
                }
            }
        },
        "search_bookmarks": {
            "display_name": "Search Bookmarks",
            "description": "Search bookmarks (full-text, semantic, or hybrid).",
            "input_schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Search string"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of results per page (default: 20, max: 100)"
                    },
                    "cursor": {
                        "type": "string",
                        "description": "Pagination cursor"
                    },
                    "search_mode": {
                        "type": "string",
                        "enum": ["fts", "semantic", "hybrid"],
                        "description": "Search strategy. 'fts' = full-text (default), 'semantic' = embedding-based, 'hybrid' = both."
                    },
                    "sort_order": {
                        "type": "string",
                        "enum": ["asc", "desc", "relevance"],
                        "description": "Result ordering. Defaults to 'relevance'."
                    },
                    "include_content": {
                        "type": "boolean",
                        "description": "Include full HTML/text content in each bookmark. Defaults to false."
                    }
                },
                "required": ["query"]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "bookmarks": {
                        "type": "array",
                        "description": "Matching bookmark objects"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Number of bookmarks returned in this page"
                    },
                    "next_cursor": {
                        "type": ["string", "null"],
                        "description": "Next page cursor, or null"
                    }
                }
            }
        },
        "get_bookmark": {
            "display_name": "Get Bookmark",
            "description": "Retrieve a bookmark by id.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "bookmark_id": {
                        "type": "string",
                        "description": "The bookmark id to fetch"
                    },
                    "include_content": {
                        "type": "boolean",
                        "description": "Include full HTML/text content in the response. Defaults to false."
                    }
                },
                "required": ["bookmark_id"]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "bookmark": {
                        "type": "object",
                        "description": "The bookmark object"
                    }
                }
            }
        },
        "create_tag": {
            "display_name": "Create Tag",
            "description": "Create a tag by name.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Tag name"
                    }
                },
                "required": ["name"]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "tag_id": {
                        "type": "string",
                        "description": "The created tag id"
                    },
                    "name": {
                        "type": "string",
                        "description": "Tag name as stored by Karakeep"
                    },
                    "tag": {
                        "type": "object",
                        "description": "The full tag object returned by Karakeep"
                    }
                },
                "required": ["tag_id"]
            }
        },
        "list_tags": {
            "display_name": "List Tags",
            "description": "List tags, optionally filtered and sorted.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "name_contains": {
                        "type": "string",
                        "description": "Optional substring filter"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of tags per page (default: 20, max: 1000)"
                    },
                    "cursor": {
                        "type": "string",
                        "description": "Pagination cursor"
                    },
                    "sort": {
                        "type": "string",
                        "enum": ["name", "usage", "relevance"],
                        "description": "Sort tags by name, usage count, or relevance to name_contains. Defaults to 'usage'. 'relevance' requires name_contains."
                    },
                    "attached_by": {
                        "type": "string",
                        "enum": ["ai", "human", "none"],
                        "description": "Filter tags by who attached them."
                    }
                }
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string" },
                                "name": { "type": "string" },
                                "numBookmarks": { "type": "integer" },
                                "numBookmarksByAttachedType": {
                                    "type": "object",
                                    "properties": {
                                        "ai": { "type": "integer" },
                                        "human": { "type": "integer" }
                                    }
                                }
                            }
                        },
                        "description": "Tag objects with usage counts"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Number of tags returned in this page"
                    },
                    "next_cursor": {
                        "type": ["string", "null"],
                        "description": "Next page cursor, or null"
                    }
                }
            }
        },
        "list_bookmarks": {
            "display_name": "List Bookmarks",
            "description": "List bookmarks, optionally filtered by archived or favourited status.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "archived": {
                        "type": "boolean",
                        "description": "If set, only return bookmarks with this archived status"
                    },
                    "favourited": {
                        "type": "boolean",
                        "description": "If set, only return bookmarks with this favourited status"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of bookmarks per page (default: 20, max: 100)"
                    },
                    "cursor": {
                        "type": "string",
                        "description": "Pagination cursor"
                    },
                    "sort_order": {
                        "type": "string",
                        "enum": ["asc", "desc"],
                        "description": "Sort by creation date. Defaults to 'desc' (newest first)."
                    },
                    "include_content": {
                        "type": "boolean",
                        "description": "Include full HTML/text content in each bookmark. Defaults to false."
                    }
                }
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "bookmarks": {
                        "type": "array",
                        "description": "Bookmark objects"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Number of bookmarks returned in this page"
                    },
                    "next_cursor": {
                        "type": ["string", "null"],
                        "description": "Next page cursor, or null"
                    }
                }
            }
        },
        "get_tag_bookmarks": {
            "display_name": "Get Bookmarks With Tag",
            "description": "List bookmarks that have a given tag.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "tag_id": {
                        "type": "string",
                        "description": "Tag id from list_tags or create_tag"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of bookmarks per page (default: 20, max: 100)"
                    },
                    "cursor": {
                        "type": "string",
                        "description": "Pagination cursor"
                    },
                    "sort_order": {
                        "type": "string",
                        "enum": ["asc", "desc"],
                        "description": "Sort by creation date. Defaults to 'desc'."
                    },
                    "include_content": {
                        "type": "boolean",
                        "description": "Include full HTML/text content in each bookmark. Defaults to false."
                    }
                },
                "required": ["tag_id"]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "bookmarks": {
                        "type": "array",
                        "description": "Bookmark objects that have this tag"
                    },
                    "count": {
                        "type": "integer",
                        "description": "Number of bookmarks returned in this page"
                    },
                    "next_cursor": {
                        "type": ["string", "null"],
                        "description": "Next page cursor, or null"
                    }
                }
            }
        }
    }
}
