{
    "name": "Google Looker",
    "version": "3.0.0",
    "description": "Access dashboards, LookML models, analytical queries, SQL Runner, and database connection metadata through the Looker API",
    "entry_point": "google_looker.py",
    "auth": {
        "type": "custom",
        "title": "Looker API Auth Configuration",
        "fields": {
            "type": "object",
            "properties": {
                "base_url": {
                    "type": "string",
                    "minLength": 1,
                    "label": "Base URL",
                    "help_text": "Please enter your Looker instance base URL (e.g., https://your-company.looker.com)"
                },
                "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "label": "Client ID",
                    "help_text": "Please enter your Looker API client ID"
                },
                "client_secret": {
                    "type": "string",
                    "minLength": 1,
                    "format": "password",
                    "label": "Client Secret",
                    "help_text": "Please enter your Looker API client secret"
                }
            },
            "required": [
                "base_url",
                "client_id",
                "client_secret"
            ]
        }
    },
    "actions": {
        "list_dashboards": {
            "display_name": "List Dashboards",
            "description": "Retrieve active dashboards visible to the connected Looker API user",
            "input_schema": {
                "type": "object",
                "properties": {
                    "fields": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Comma-separated list of fields to return in the response"
                    }
                },
                "required": []
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "dashboards": {
                        "type": "array",
                        "description": "List of dashboards",
                        "items": {
                            "type": "object"
                        }
                    }
                },
                "required": [
                    "dashboards"
                ]
            }
        },
        "get_dashboard": {
            "display_name": "Get Dashboard",
            "description": "Retrieve a dashboard visible to the connected Looker API user, optionally using a field projection",
            "input_schema": {
                "type": "object",
                "properties": {
                    "dashboard_id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The unique identifier of the dashboard to retrieve (obtained from list_dashboards action)"
                    },
                    "fields": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Comma-separated list of fields to return"
                    }
                },
                "required": [
                    "dashboard_id"
                ]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "dashboard": {
                        "type": "object",
                        "description": "Dashboard object returned by Looker for the requested field projection"
                    }
                },
                "required": [
                    "dashboard"
                ]
            }
        },
        "execute_lookml_query": {
            "display_name": "Execute LookML Query",
            "description": "Execute an inline LookML query against a specified model and Explore, returning the query results directly",
            "input_schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The LookML model name (use list_models to find available models)"
                    },
                    "explore": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The explore name within the specified model (represents a data table/view to query)"
                    },
                    "dimensions": {
                        "type": "array",
                        "description": "Dimensions",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "measures": {
                        "type": "array",
                        "description": "Measures",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "filters": {
                        "type": "object",
                        "description": "Query filters as field-name to filter-expression pairs",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "sorts": {
                        "type": "array",
                        "description": "Sort orders",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum rows to return; use -1 for unlimited results",
                        "anyOf": [
                            {
                                "const": -1
                            },
                            {
                                "minimum": 1
                            }
                        ]
                    },
                    "result_format": {
                        "type": "string",
                        "description": "Text or JSON result format supported by the Autohive fetch layer",
                        "enum": [
                            "json",
                            "json_bi",
                            "json_detail",
                            "csv",
                            "txt",
                            "html",
                            "md",
                            "sql"
                        ],
                        "default": "json"
                    },
                    "apply_formatting": {
                        "type": "boolean",
                        "description": "Apply formatting"
                    },
                    "apply_vis": {
                        "type": "boolean",
                        "description": "Apply visualization"
                    }
                },
                "required": [
                    "model",
                    "explore"
                ]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "query_results": {
                        "type": "string",
                        "description": "Query results"
                    }
                },
                "required": [
                    "query_results"
                ]
            }
        },
        "list_models": {
            "display_name": "List Models",
            "description": "Retrieve LookML models visible to the connected API user, with server-side projection and pagination options",
            "input_schema": {
                "type": "object",
                "properties": {
                    "fields": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Comma-separated list of fields to return"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Number of models to return",
                        "minimum": 1
                    },
                    "offset": {
                        "type": "integer",
                        "description": "Number of models to skip before returning results",
                        "minimum": 0
                    },
                    "exclude_empty": {
                        "type": "boolean",
                        "description": "Exclude models that have no explores",
                        "default": false
                    },
                    "exclude_hidden": {
                        "type": "boolean",
                        "description": "Exclude hidden explores from model results",
                        "default": false
                    },
                    "include_internal": {
                        "type": "boolean",
                        "description": "Include built-in models such as System Activity",
                        "default": false
                    },
                    "include_self_service": {
                        "type": "boolean",
                        "description": "Include self-service models",
                        "default": false
                    }
                },
                "required": []
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "models": {
                        "type": "array",
                        "description": "List of models",
                        "items": {
                            "type": "object"
                        }
                    }
                },
                "required": [
                    "models"
                ]
            }
        },
        "get_model": {
            "display_name": "Get Model",
            "description": "Retrieve a LookML model visible to the connected API user, optionally using a field projection",
            "input_schema": {
                "type": "object",
                "properties": {
                    "model_name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Model name"
                    },
                    "fields": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Comma-separated list of fields to return"
                    }
                },
                "required": [
                    "model_name"
                ]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "object",
                        "description": "Model data"
                    }
                },
                "required": [
                    "model"
                ]
            }
        },
        "execute_sql_query": {
            "display_name": "Execute SQL Query",
            "description": "Create and execute a SQL Runner query. SQL may modify database data or schema when the selected connection permits writes; use read-only database credentials for agent workflows.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "sql": {
                        "type": "string",
                        "description": "SQL statement to execute. Looker SQL Runner permits DDL and DML when the database credentials allow them.",
                        "minLength": 1
                    },
                    "connection_name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The database connection name to execute the SQL against (use list_connections to find available connections)"
                    },
                    "model_name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Model name (alternative to connection_name)"
                    },
                    "vis_config": {
                        "type": "object",
                        "description": "Optional visualization configuration object"
                    },
                    "result_format": {
                        "type": "string",
                        "description": "Text or JSON result format supported by the Autohive fetch layer",
                        "enum": [
                            "inline_json",
                            "json",
                            "json_detail",
                            "json_fe",
                            "json_bi",
                            "csv",
                            "html",
                            "md",
                            "txt",
                            "gsxml",
                            "sql",
                            "json_label"
                        ],
                        "default": "json"
                    },
                    "download": {
                        "type": "string",
                        "description": "Whether Looker should set download-oriented response headers",
                        "enum": [
                            "true",
                            "false"
                        ],
                        "default": "false"
                    }
                },
                "required": [
                    "sql"
                ],
                "oneOf": [
                    {
                        "required": [
                            "connection_name"
                        ],
                        "not": {
                            "required": [
                                "model_name"
                            ]
                        }
                    },
                    {
                        "required": [
                            "model_name"
                        ],
                        "not": {
                            "required": [
                                "connection_name"
                            ]
                        }
                    }
                ]
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string",
                        "description": "Created SQL query slug"
                    },
                    "query_results": {
                        "type": "string",
                        "description": "Query execution results"
                    }
                },
                "required": [
                    "slug",
                    "query_results"
                ]
            }
        },
        "list_connections": {
            "display_name": "List Connections",
            "description": "Retrieve database connection metadata visible to the connected Looker API user",
            "input_schema": {
                "type": "object",
                "properties": {
                    "fields": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Comma-separated list of fields to return"
                    }
                },
                "required": []
            },
            "output_schema": {
                "type": "object",
                "properties": {
                    "connections": {
                        "type": "array",
                        "description": "List of database connections",
                        "items": {
                            "type": "object"
                        }
                    }
                },
                "required": [
                    "connections"
                ]
            }
        }
    },
    "display_name": "Google Looker"
}
