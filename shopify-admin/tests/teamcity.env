# Use a dedicated test store. Values resolve from /integration-testing/shopify-admin/<ENV_VAR>.
SHOPIFY_STORE_URL=ah:secret
SHOPIFY_CLIENT_ID=ah:secret
SHOPIFY_CLIENT_SECRET=ah:secret

