# Resolve through the dedicated Lusha custom-auth test connection; never put a key here.
LUSHA_API_KEY=ah:customAuth:api_key
# Opt into the small, bounded suite of credit-consuming search/enrichment/prospecting requests.
LUSHA_RUN_PAID_TESTS=1
LUSHA_TEST_COMPANY_DOMAIN=lusha.com
# Configure a permitted dedicated-test contact with a known available Lusha email.
LUSHA_TEST_CONTACT_ID=v1.0z5pbdNOlsi5vQJ0EogFnghaNxngetG32A
# Alternatively provision the test contact email securely, then uncomment:
# LUSHA_TEST_CONTACT_EMAIL=ah:secret
# Optional: an actual unexpired Waterfall job belonging to this test account.
# LUSHA_TEST_ENRICHMENT_JOB_ID=
