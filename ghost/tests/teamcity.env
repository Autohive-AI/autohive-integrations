# Use a dedicated test account. Values resolve from /integration-testing/ghost/<ENV_VAR>.
GHOST_API_URL=ah:secret
GHOST_CONTENT_API_KEY=ah:secret
GHOST_ADMIN_API_KEY=ah:secret

