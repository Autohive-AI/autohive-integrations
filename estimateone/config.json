{
    "name": "estimateone",
    "display_name": "EstimateOne (E1)",
    "version": "2.0.0",
    "description": "Retrieve supplier Speci-finder matched construction projects and tenders for lead discovery and CRM workflows.",
    "entry_point": "estimateone.py",
    "supports_billing": false,
    "auth": {
        "type": "custom",
        "title": "E1 Partner Credentials",
        "fields": {
            "type": "object",
            "properties": {
                "client_id": {
                    "type": "string",
                    "format": "password",
                    "label": "Client ID",
                    "help_text": "Issued by E1 during partner onboarding.",
                    "minLength": 1
                },
                "client_secret": {
                    "type": "string",
                    "format": "password",
                    "label": "Client Secret",
                    "help_text": "Issued by E1 during partner onboarding.",
                    "minLength": 1
                }
            },
            "required": [
                "client_id",
                "client_secret"
            ]
        }
    },
    "actions": {
        "list_matched_projects": {
            "display_name": "List Matched Projects",
            "description": "Return a compact page of supplier-matched project leads for opportunity discovery. Use include_tenders=true for tender deadlines and builder names; do not use this to create tenders, submit quotes, or search all public projects (no such action is provided). company_id is the E1 account number supplied during onboarding; no action discovers it. Defaults: limit=25 (maximum 100), include_tenders=false, one provider page, and a 32 KiB response cap. Narrow new-project discovery with created_since instead of paging; this filters project creation, not updates. To continue a listing, pass next_cursor unchanged to list_matched_projects with the same company and filters. total_matching is null because E1 supplies no total count.",
            "input_schema": {
                "type": "object",
                "properties": {
                    "company_id": {
                        "type": "string",
                        "description": "Registered supplier company account number supplied during E1 onboarding (Account # in E1). No integration action discovers this ID; it is not a project or tender ID.",
                        "pattern": "^[0-9]+$"
                    },
                    "created_since": {
                        "type": "string",
                        "description": "Optional RFC 3339 project-creation timestamp with time and UTC offset, such as 2026-01-01T00:00:00Z. Omit for all live matches. Does not capture updates or newly added tenders on older projects.",
                        "format": "date-time"
                    },
                    "cursor": {
                        "type": "string",
                        "description": "Opaque next_cursor returned by list_matched_projects. Reuse with the same company_id and created_since; omit to start a new listing."
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Projects per page: default 25, minimum 1, maximum 100. Reduce this if the result exceeds 32 KiB; the handler never returns a silently cut-off page.",
                        "minimum": 1,
                        "maximum": 100,
                        "default": 25
                    },
                    "include_tenders": {
                        "type": "boolean",
                        "default": false,
                        "description": "Default false. Set true to include compact tender IDs, names, types, builder names, and quote deadlines. Descriptions, consultants, subcontractors, and other bulk enrichment are omitted."
                    }
                },
                "required": [
                    "company_id"
                ],
                "additionalProperties": false
            },
            "output_schema": {
                "type": "object",
                "description": "Bounded project page, with explicit pagination and unknown account-wide count.",
                "properties": {
                    "company_id": {
                        "type": "string",
                        "description": "Echo of the requested supplier company ID."
                    },
                    "projects": {
                        "type": "array",
                        "description": "Curated project summaries in E1 response order.",
                        "items": {
                            "type": "object",
                            "description": "Project lead summary; caller company_id is echoed at the top level.",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "description": "E1 project ID."
                                },
                                "name": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "description": "Project name, or null."
                                },
                                "status": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "description": "Provider project status, or null."
                                },
                                "category": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "description": "Project category, or null."
                                },
                                "address": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "description": "Project address, or null."
                                },
                                "created_at": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "description": "Provider project creation timestamp, or null."
                                },
                                "budget": {
                                    "type": "object",
                                    "description": "Budget bounds as supplied by E1; missing bounds are null, never zero.",
                                    "properties": {
                                        "low": {
                                            "type": [
                                                "number",
                                                "null"
                                            ],
                                            "description": "Lower budget bound, or null."
                                        },
                                        "high": {
                                            "type": [
                                                "number",
                                                "null"
                                            ],
                                            "description": "Upper budget bound, or null."
                                        }
                                    },
                                    "required": [
                                        "low",
                                        "high"
                                    ],
                                    "additionalProperties": false
                                },
                                "tender_count": {
                                    "type": "integer",
                                    "description": "Number of matched tenders in this returned project; not an account-wide total."
                                },
                                "tenders": {
                                    "type": "array",
                                    "description": "Compact tender records when include_tenders=true; otherwise empty.",
                                    "items": {
                                        "type": "object",
                                        "description": "Compact tender; no body, attachments, or unrelated provider fields.",
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "description": "Tender ID returned by E1."
                                            },
                                            "name": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ],
                                                "description": "Tender name, or null when unavailable."
                                            },
                                            "type": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ],
                                                "description": "Provider tender type, or null."
                                            },
                                            "builder": {
                                                "type": "object",
                                                "description": "Builder reference; E1 does not supply its ID.",
                                                "properties": {
                                                    "name": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ],
                                                        "description": "Builder name, or null."
                                                    }
                                                },
                                                "required": [
                                                    "name"
                                                ],
                                                "additionalProperties": false
                                            },
                                            "quotes_due_at": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ],
                                                "description": "Quote closing date in provider YYYY-MM-DD format, or null."
                                            }
                                        },
                                        "required": [
                                            "id",
                                            "name",
                                            "type",
                                            "builder",
                                            "quotes_due_at"
                                        ],
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "required": [
                                "id",
                                "name",
                                "status",
                                "category",
                                "address",
                                "created_at",
                                "budget",
                                "tender_count",
                                "tenders"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "returned_count": {
                        "type": "integer",
                        "description": "Number of projects in this page."
                    },
                    "total_matching": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Always null: E1 does not report the full matching count."
                    },
                    "next_cursor": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Pass unchanged as cursor to continue; null at the end."
                    },
                    "has_next_page": {
                        "type": "boolean",
                        "description": "Whether E1 reports another provider page."
                    },
                    "truncated": {
                        "type": "boolean",
                        "description": "True when more matches remain on later provider pages; no returned record is silently cut off."
                    },
                    "message": {
                        "type": "string",
                        "description": "Continuation guidance, or the most likely reason for an empty result."
                    }
                },
                "required": [
                    "company_id",
                    "projects",
                    "returned_count",
                    "total_matching",
                    "next_cursor",
                    "has_next_page",
                    "truncated",
                    "message"
                ],
                "additionalProperties": false
            }
        }
    }
}
