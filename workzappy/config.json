                    "project_name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "template_code": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": {
                        "type": "string",
                        "minLength": 1
                    },
                    "leader_id": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
